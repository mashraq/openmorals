{
  "name": "openmorals",
  "version": "0.44.0",
  "description": "A local policy engine that asks before an AI coding agent deletes, force-pushes, drops a database, deletes something online, leaks a secret or overspends its budget.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashraq/openmorals.git"
  },
  "homepage": "https://github.com/mashraq/openmorals#readme",
  "bugs": {
    "url": "https://github.com/mashraq/openmorals/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openmorals": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "cases",
    "packs",
    "skills",
    "API.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "build:binary": "node scripts/build-binary.mjs",
    "test:binary": "node scripts/compare-binary.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "openclaw",
    "hooks",
    "policy",
    "safety",
    "guard"
  ],
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.0"
  }
}
