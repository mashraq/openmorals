{
  "name": "openmorals",
  "version": "0.36.2",
  "description": "A local policy engine that asks before an AI coding agent deletes, force-pushes, drops a database, deletes something online, leaks a secret or overspends its budget.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openmorals": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "cases",
    "packs",
    "API.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "build:binary": "node scripts/build-binary.mjs",
    "test:binary": "node scripts/compare-binary.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "hooks",
    "policy",
    "safety",
    "guard"
  ],
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.0"
  }
}
